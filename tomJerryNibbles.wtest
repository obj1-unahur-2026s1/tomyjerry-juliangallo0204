import tomJerryNibbles.*

describe "Grupo de test 1" {

  test "Al inicio, la velocidad máxima de Tom es 10" {
    assert.equals(10, tom.velocidadMaxima())
  }

  test "Si come a Jerry, la velocidad máxima pasa a ser  15.2" {
    tom.comer(jerry)
    assert.equals(15.2, tom.velocidadMaxima())
  }

  test "Si corre 24 metros, entonces su velocidad máxima pasa a ser 14" {
    tom.comer(jerry)
    tom.correr(24)
    assert.equals(14, tom.velocidadMaxima())
  }

  test "Si come a Nibbles, pasa a tener de velocidad máxima 18.7" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    assert.equals(18.7, tom.velocidadMaxima())
  }

  test "si Jerry cumple años (3 años de edad), y luego Tom lo vuelve a comer, pasaría a tener 25.9" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAnios()
    tom.comer(jerry)
    assert.equals(25.9, tom.velocidadMaxima())
  }

  test "si corre 38 metros su velocidad pasa a ser 24" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAnios()
    tom.comer(jerry)
    tom.correr(38)
    assert.equals(24, tom.velocidadMaxima())
  }
}

describe "Grupo de test 2" {

  test "si Cherie está enamorada de Jerry y luego Tom la caza a 30 metros, su velocidad máxima sería de 12.7" {
    tom.cazar(cherie, 30)
    assert.equals(12.7, tom.velocidadMaxima())
  }

  test "si Cherie se desenamora de Jerry, y luego Tom la caza a 30 metros, su velocidad máxima pasaría a 12.2" {
    cherie.desenamorarse()
    tom.cazar(cherie, 30)
    assert.equals(12.2, tom.velocidadMaxima())
  }

  test "Cherie sigue desenamorada, pero esta vez logra escapar de Tom a una distancia de 110 metros. Tom intenta cazarla, por lo tanto su velocida maxima sería de 10" {
    cherie.desenamorarse()
    tom.cazar(cherie, 110)
    assert.equals(10, tom.velocidadMaxima())
  }
}